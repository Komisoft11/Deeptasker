CLIENT_URL=http://deeptasker.test:3000 # preview: http://deeptasker.test:4173

# RabbitMQ
RABBITMQ_URI=amqp://user:deeptasker@127.0.0.1:35672
RABBITMQ_QUEUE=notification_queue
RABBITMQ_QUEUE_DURABLE=true
RABBITMQ_EVENTS_EXCHANGE=events

# SMTP
SMTP_HOST=smtp.deeptasker.net
SMTP_PORT=465
SMTP_USER=noreply@deeptasker.net
SMTP_PASSWORD=password

#DB
DATABASE_URL=postgresql://postgres:password@localhost:35434/notification

#gRPC
GRPC_URL=0.0.0.0:50051
